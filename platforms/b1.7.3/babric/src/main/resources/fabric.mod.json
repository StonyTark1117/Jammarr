{
  "schemaVersion": 1,
  "id": "jammarr",
  "version": "${version}",
  "name": "Jammarr",
  "description": "Streams a shared, synchronized Plex music queue to capable clients.",
  "authors": ["stonytark_mkii"],
  "license": "CC0-1.0",
  "icon": "jammarr.png",
  "environment": "*",
  "entrypoints": {
    "main": ["stonytark.jammarr.Jammarr"],
    "client": ["stonytark.jammarr.client.LegacyClient"],
    "stationapi:event_bus_client": [
      "stonytark.jammarr.client.BabricClientEvents",
      "stonytark.jammarr.client.BabricClientNetworkEvents"
    ],
    "stationapi:event_bus_server": ["stonytark.jammarr.server.BabricServerEvents"]
  },
  "mixins": ["jammarr.babric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "1.0.0-beta.7.3",
    "java": ">=17",
    "stationapi": ">=2.0.0-alpha.6.2"
  }
}
